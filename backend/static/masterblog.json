{
  "swagger": "2.0",
  "info": {
    "title": "Masterblog API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Post",
      "description": "Post API - CRUD & Search"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Get all posts with optional sorting",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort by (title, content, author or date)",
            "required": false,
            "type": "string",
            "enum": [
              "title",
              "content",
              "author",
              "date"
            ]
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction (asc or desc)",
            "required": false,
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Post storage could not be read or written"
          }
        }
      },
      "post": {
        "summary": "Create a new post",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "New Blog Post"
                },
                "content": {
                  "type": "string",
                  "example": "This is the content of the new post."
                },
                "author": {
                  "type": "string",
                  "example": "Dennis"
                },
                "date": {
                  "type": "string",
                  "example": "2026-10-26"
                }
              },
              "required": [
                "title",
                "content"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Post storage could not be read or written"
          }
        }
      }
    },
    "/api/posts/{post_id}": {
      "put": {
        "summary": "Update an existing post",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post to update"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Post not found"
          },
          "500": {
            "description": "Post storage could not be read or written"
          }
        }
      },
      "delete": {
        "summary": "Delete a post by ID",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted"
          },
          "404": {
            "description": "Post not found"
          },
          "500": {
            "description": "Post storage could not be read or written"
          }
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Search posts by title, content, author or date",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "Search term for title",
            "required": false,
            "type": "string"
          },
          {
            "name": "content",
            "in": "query",
            "description": "Search term for content",
            "required": false,
            "type": "string"
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Search term for author"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Search term for date"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Search across all post fields"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Post storage could not be read or written"
          }
        }
      }
    }
  },
  "basePath": "/"
}
